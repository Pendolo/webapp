# Environment template for Pendolo webapp.
# Copy to .env.local and fill in real values. Never commit secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres (server-only)
DATABASE_URL=

# Supabase project (server-only in the MVP)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# First-party session cookie signing/encryption
SESSION_SECRET=

# Transactional email provider
EMAIL_PROVIDER_API_KEY=

# Vercel Cron authorization
CRON_SECRET=
